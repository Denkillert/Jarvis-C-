<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis AI" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Область чата -->
        <RichTextBox x:Name="ChatHistory" 
                     Grid.Row="0" 
                     IsReadOnly="True" 
                     Background="#2D2D30" 
                     Foreground="White" 
                     FontSize="14" 
                     Margin="0,0,0,15"
                     BorderThickness="1" 
                     BorderBrush="#3E3E42">
            <FlowDocument>
                <Paragraph x:Name="ChatParagraph" />
            </FlowDocument>
        </RichTextBox>

        <!-- Область ввода -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" 
                     Grid.Column="0"
                     Height="40" 
                     FontSize="16" 
                     VerticalContentAlignment="Center" 
                     Margin="0,0,10,0"
                     Background="#3E3E42"
                     Foreground="White"
                     BorderBrush="#555555"
                     KeyDown="InputBox_KeyDown"/>

            <Button x:Name="MicButton" 
                    Grid.Column="1"
                    Content="🎤" 
                    FontSize="20" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Background="#3E3E42"
                    Foreground="White"
                    BorderBrush="#555555"
                    Click="MicButton_Click"/>

            <Button x:Name="SendButton" 
                    Grid.Column="2"
                    Content="Отправить" 
                    Height="40" 
                    FontSize="16"
                    Background="#007ACC"
                    Foreground="White"
                    BorderBrush="#007ACC"
                    Click="SendButton_Click"/>

            <Border Background="#1E1E1E" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusLabel" 
                   Text="⏸ Ожидание..." 
                   Foreground="Gray" 
                   FontSize="14"
                   FontWeight="SemiBold"/>
                    <TextBlock Text="  |  " Foreground="#555" Margin="10,0"/>
                    <TextBlock x:Name="ContextLabel" 
                   Text="Контекст: Рабочий стол" 
                   Foreground="#888" 
                   FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>