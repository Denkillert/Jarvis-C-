<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <TextBlock x:Name="ChatHistory" 
               TextWrapping="Wrap" 
               FontSize="14" 
               Foreground="White"/>
        </ScrollViewer>

        <TextBox x:Name="InputBox" 
                 Grid.Row="1" 
                 Height="40" 
                 Background="#2D2D2D" 
                 Foreground="White"
                 Padding="10"
                 VerticalContentAlignment="Center"/>

        <Button x:Name="SendButton" 
                Grid.Row="2" 
                Content="Отправить" 
                Height="40" 
                Margin="0,10,0,0"
                Background="#4CAF50" 
                Foreground="White"
                FontSize="14"/>
    </Grid>
</Window>