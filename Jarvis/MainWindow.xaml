<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <TextBlock x:Name="ChatHistory" 
               TextWrapping="Wrap" 
               FontSize="14" 
               Foreground="White"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="InputBox" 
             Width="500" 
             Height="40" 
             FontSize="16" 
             VerticalContentAlignment="Center" 
             Margin="0,0,10,0"/>

            <!-- КНОПКА МИКРОФОНА -->
            <Button x:Name="MicButton" 
            Content="🎤" 
            FontSize="20" 
            Width="50" 
            Height="40" 
            Margin="0,0,10,0"
            ToolTip="Нажми, чтобы говорить"/>

            <Button x:Name="SendButton" 
            Content="Отправить" 
            Width="100" 
            Height="40" 
            FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>